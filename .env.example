# Which provider AION uses: "gemini" (default), "claude", or
# "openai-compatible" (also accepts "openchat").
# decide/history/verify never read this and never need any provider SDK.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Only needed when AI_PROVIDER=claude. Requires: pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# For a self-hosted OpenChat server or any OpenAI-compatible endpoint.
# Example local OpenChat server: http://localhost:18888/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=openchat_3.6

# Optional AI artwork for Instagram. Leave IMAGE_PROVIDER=branded-card for
# the free, deterministic visual renderer. Set it to "openai" only after
# adding an API key. This key may be the same as OPENAI_COMPATIBLE_API_KEY.
IMAGE_PROVIDER=branded-card
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Optional best-effort, no-key Reel narration. A Reel stays caption-led if
# synthesis is unavailable; set to "none" to always disable it.
REEL_VOICE_PROVIDER=edge-tts
REEL_VOICE=en-US-AvaMultilingualNeural

# Only needed for the "run-social-cycle" / "draft-post" commands
# (Phase 10, Facebook posting). Requires: pip install requests
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Only needed to enable Telegram notifications for "draft-post" /
# "run-social-cycle" (optional -- both commands work fine without it,
# they just won't notify). Requires: pip install requests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed for Instagram publishing (tools/instagram.py). The
# Instagram professional account must be linked to the Facebook Page
# above. Requires: pip install requests
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# YouTube Shorts publishing (tools/youtube.py).  Create the refresh token once
# with: python tools/youtube_authorize.py --client-secrets path/to/client_secret.json
# Keep all three values private: never commit them or paste them into source code.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# New YouTube API projects may be limited to private uploads until YouTube
# completes an audit.  Keep this private until that restriction is lifted.
YOUTUBE_PRIVACY_STATUS=private
# Public creator destinations used for occasional cross-platform invitations.
# YouTube is already registered in core/platforms.json.
AION_INSTAGRAM_URL=
AION_FACEBOOK_URL=
