# Which provider run_reflection() uses: "gemini" (default) or "claude".
# decide/history/verify never read this and never need any provider SDK.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Only needed when AI_PROVIDER=claude. Requires: pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
